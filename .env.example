# Cognilearn AI (Bharat AI) Environment Configuration Example
# Copy this file to '.env' and fill in your keys if you want to enable live cloud APIs.
# The system works fully offline with automated fallback mock engines if no keys are provided.

# --- LLM Providers ---
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
DEFAULT_LLM_MODEL=gpt-4o-mini

# --- Text-to-Speech (TTS) Providers ---
DEEPGRAM_API_KEY=your_deepgram_api_key_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=eastus

# --- Talking Avatar Video Providers ---
D_ID_API_KEY=your_d_id_api_key_here
HEYGEN_API_KEY=your_heygen_api_key_here

# --- Server & Runtime Settings ---
PORT=8000
HOST=127.0.0.1
DEBUG=True
ENVIRONMENT=development
